# ---------------------------------------------------------------------------
# Quittance environment
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed as
# the template and must never contain a real key.
#
#   cp .env.example .env
#
# `node scripts/check-env.mjs` validates everything below and fails loudly
# rather than letting a run produce numbers against the wrong cluster.
# ---------------------------------------------------------------------------

# --- RPC -------------------------------------------------------------------
#
# The Helius devnet endpoint, with the API key in it.
#
#   https://dashboard.helius.dev  →  create a project  →  Devnet  →  copy the
#   RPC URL. It looks like:
#
#     https://devnet.helius-rpc.com/?api-key=00000000-0000-0000-0000-000000000000
#
# The public endpoint `api.devnet.solana.com` is rejected by the startup
# assertion on purpose. It rate-limits hard enough to make the fault campaign's
# timing numbers meaningless, and a campaign run against it would produce
# figures that look like evidence and are not.
HELIUS_RPC_URL=

# Optional. A separate endpoint for the harness, if you want campaign traffic
# on its own key so one run cannot rate-limit the other. Falls back to
# HELIUS_RPC_URL when empty.
HELIUS_RPC_URL_HARNESS=

# --- Cluster ---------------------------------------------------------------
#
# `devnet` or `mainnet-beta`. Everything in this build targets devnet. The
# assertion refuses mainnet-beta unless QUITTANCE_ALLOW_MAINNET is also set,
# because nothing here should reach mainnet by accident.
SOLANA_CLUSTER=devnet

# --- Keypairs --------------------------------------------------------------
#
# Paths, never key material. Generated by:
#
#   node scripts/keygen.mjs .keys/payer.json .keys/adversary.json
#
# PAYER     deploys the program, pays nonce-account rent, funds test transfers.
# ADVERSARY an independent signer. Fault F8 needs a second party to advance a
#           nonce account out from under a pending contribution; the same
#           wallet cannot play both roles, or the fault proves nothing.
PAYER_KEYPAIR_PATH=.keys/payer.json
ADVERSARY_KEYPAIR_PATH=.keys/adversary.json

# The program keypair. Already generated and gitignored; its public key is the
# one in `declare_id!` and in `Anchor.toml`.
PROGRAM_KEYPAIR_PATH=program/keys/quittance-keypair.json

# --- SKR -------------------------------------------------------------------
#
# The nonce lease is denominated in SKR. Leave SKR_MINT empty until the real
# devnet mint address is confirmed.
#
# While it is empty the lease runs against a stand-in mint and every surface
# that mentions the lease says so: the app renders a labelled notice, the
# engine carries `mintIsGenuineSkr: false`, and `LIMITATIONS.md` states it
# against the specific claim it affects. A stand-in is never presented as real.
SKR_MINT=
SKR_MINT_IS_GENUINE=false

# --- Device ----------------------------------------------------------------
#
# Recorded into every campaign row. Numbers from an unidentified device are
# not evidence. Filled by `node scripts/check-env.mjs --probe-device`.
ANDROID_DEVICE_SERIAL=
ANDROID_DEVICE_MODEL=
ANDROID_VERSION=
WALLET_PACKAGE=com.solflare.mobile
WALLET_VERSION=

# The package the harness force-stops to inject a process kill.
PROBE_PACKAGE=com.quittance.probe
APP_PACKAGE=com.quittance.app
