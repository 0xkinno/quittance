{
  "name": "@quittance/verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Recomputes every Quittance verdict from an exported intent log plus chain state. No app, no wallet, no model.",
  "license": "MIT",
  "type": "module",
  "bin": { "quittance-verify": "./dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "verify": "node dist/cli.js"
  },
  "dependencies": {
    "@quittance/engine": "workspace:*",
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.9.3"
  }
}
