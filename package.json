{
  "name": "quittance",
  "version": "0.1.0",
  "private": true,
  "description": "A savings circle that knows who paid even when the phone dies mid-payment.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "verify": "pnpm --filter @quittance/verifier run verify",
    "campaign": "pnpm --filter @quittance/harness run campaign",
    "manifest": "node --experimental-strip-types scripts/manifest.ts",
    "readme": "node --experimental-strip-types scripts/generate_readme.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
